# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-32-char-secret-here

# ── Turso Database ─────────────────────────────────────────────────────────────
# Get from: https://turso.tech → Create database → Get connection URL
# Format: libsql://your-db-name.turso.io
TURSO_DATABASE_URL=libsql://your-db.turso.io
# Get from: Turso dashboard → Database → Generate auth token
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Get from: Cloudflare dashboard → R2 → Manage R2 API Tokens
# Account ID: Cloudflare dashboard → right sidebar
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=misbah-bih
# Public URL of your R2 bucket (enable public access in R2 dashboard)
# Format: https://pub-XXXX.r2.dev  OR  https://files.yourdomain.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Local development only (not needed on Vercel) ─────────────────────────────
DATABASE_URL=file:./prisma/dev.db
