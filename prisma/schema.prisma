generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Video {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  author       String?
  url          String
  platform     String
  embedUrl     String
  thumbnailUrl String?
  isShortForm  Boolean   @default(false)
  category     String    @default("predavanja") // predavanja | kuran | podcast | ilahije | zikrovi
  topic        String?   // tefsir | hadis | sira | opste | akaid | fikh | duhovnost | historija
  published    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  likes        Like[]
  comments     Comment[]
}

model BlogPost {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  author    String?
  imageUrl  String?
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  likes     Like[]
  comments  Comment[]
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  likes        Like[]
  comments     Comment[]
}

model Like {
  id         Int       @id @default(autoincrement())
  userId     Int
  videoId    Int?
  blogPostId Int?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video      Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@unique([userId, blogPostId])
}

model Comment {
  id         Int       @id @default(autoincrement())
  userId     Int
  content    String
  videoId    Int?
  blogPostId Int?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video      Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
}

model Activity {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  date      DateTime @default(now())
  tag       String   @default("aktivnosti") // vijesti | novosti | aktivnosti
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quote {
  id        Int      @id @default(autoincrement())
  type      String   @default("izreka") // ajet | hadis | izreka
  text      String
  source    String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id          Int      @id @default(autoincrement())
  title       String?
  imageUrl    String
  description String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IlahijaText {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  author    String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  fullName     String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
}
