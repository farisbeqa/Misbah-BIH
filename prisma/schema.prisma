generator client {
  provider = "prisma-client-js"
}

// Aurora DSQL (PostgreSQL-compatible) on AWS. DSQL has no foreign keys, so
// Prisma enforces the relations (and the cascading deletes) itself.
datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Video {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  author       String?
  url          String
  platform     String
  embedUrl     String
  thumbnailUrl String?
  isShortForm  Boolean   @default(false)
  category     String    @default("predavanja") // predavanja | kuran | podcast | ilahije | zikrovi
  topic        String? // tefsir | hadis | sira | opste | akaid | fikh | duhovnost | historija
  published    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  likes        Like[]
  comments     Comment[]
}

model BlogPost {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  author    String?
  imageUrl  String?
  category  String    @default("savjeti") // hutbe | aktuelne-teme | duhovnost | tefsir-kuran | sira | fikh | savjeti | odgoj
  published Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  likes     Like[]
  comments  Comment[]
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  likes        Like[]
  comments     Comment[]
}

model Like {
  id         Int       @id @default(autoincrement())
  userId     Int
  videoId    Int?
  blogPostId Int?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video      Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@unique([userId, blogPostId])
  @@index([videoId])
  @@index([blogPostId])
}

model Comment {
  id         Int       @id @default(autoincrement())
  userId     Int
  content    String
  videoId    Int?
  blogPostId Int?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video      Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([videoId])
  @@index([blogPostId])
}

model Activity {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  imageUrl  String?
  videoUrl  String?
  date      DateTime @default(now())
  tag       String   @default("aktivnosti") // vijesti | novosti | aktivnosti
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quote {
  id        Int      @id @default(autoincrement())
  type      String   @default("izreka") // ajet | hadis | izreka
  text      String
  source    String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id          Int      @id @default(autoincrement())
  title       String?
  imageUrl    String
  description String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IlahijaText {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  author    String?
  audioUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DuaText {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  author    String?
  audioUrl  String?
  category  String   @default("opste") // opste | kuransko
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MektebPost {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  author    String?
  imageUrl  String?
  category  String   @default("opste") // opste | program | kviz | materijali
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ZikrText {
  id           Int      @id @default(autoincrement())
  title        String
  content      String?
  author       String?
  audioUrl     String?
  thumbnailUrl String?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Prica {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  author    String?
  imageUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  fullName     String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// Reports of objectionable comments (app "Prijavi" button), handled at /admin/komentari.
// Created on Turso with scripts/add-comment-report-table.js
model CommentReport {
  id        Int      @id @default(autoincrement())
  commentId Int
  reason    String?
  reporter  String?
  createdAt DateTime @default(now())

  @@index([commentId])
}

// "Dnevne poruke" for the mobile app's daily notifications: seven rubrics,
// one per weekday by default (see src/lib/daily.ts). Edited at /admin/dnevno.
// Created on Turso with scripts/add-daily-post-table.js
model DailyPost {
  id        Int      @id @default(autoincrement())
  rubric    String // hadis | kuran | izazov | fikh | preporuka | kviz | enciklopedija
  date      String // YYYY-MM-DD, the day the notification goes out
  title     String
  teaser    String? // notification text (title is used when empty)
  body      String   @default("")
  source    String?
  videoUrl  String?
  link      String? // "Misbah preporučuje": the recommended page
  quiz      String? // JSON: [{ q, options, answer, explanation }]
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}
